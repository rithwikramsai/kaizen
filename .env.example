# ============================================================
# KIET Backend Environment Variables
# Copy this file to .env and fill in values for local dev.
# Never commit .env — it is gitignored.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://kiet:kiet_local@localhost:5433/kiet_dev
DATABASE_TEST_URL=postgresql://kiet:kiet_local@localhost:5433/kiet_test

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth ---
# Generate a strong random secret for production: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret_before_any_deployment
JWT_EXPIRES_IN=24h

# --- File Storage ---
# Adapter: local | s3 | azure_blob | minio
FILE_STORAGE_ADAPTER=local
FILE_STORAGE_LOCAL_PATH=./uploads

# --- Email ---
# Adapter: mock | mailhog | smtp
EMAIL_ADAPTER=mailhog
MAILHOG_HOST=localhost
MAILHOG_PORT=1025
# SMTP settings (used when EMAIL_ADAPTER=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@acg.com

# ============================================================
# KIET Frontend Environment Variables
# Vite exposes only VITE_* prefixed vars to the browser.
# ============================================================

VITE_API_BASE_URL=http://localhost:3000/api/v1
